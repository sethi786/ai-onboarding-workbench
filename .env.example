# ---------------------------------------------------------------------------
# Aegis — environment variables
# Copy to .env.local and fill in with your Supabase project values.
# NEVER commit .env.local. See README "Supabase setup" for the full runbook.
# ---------------------------------------------------------------------------

# Public site URL (used for auth redirect callbacks). No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Service role key — trusted server handlers and seed scripts ONLY.
# Used for signed billing reconciliation and validated lead intake. Never expose to a browser.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Commercial launch: never put server secrets in NEXT_PUBLIC_* variables.
# Keep false until the runbook's hosted acceptance tests and policy review pass.
LAUNCH_APPROVED=false
# Operator administration at /admin. Comma-separated verified Supabase user UUIDs.
# Server-only; empty disables access. Workspace roles do not grant this privilege.
AEGIS_ADMIN_USER_IDS=
NEXT_PUBLIC_LEGAL_ENTITY=
NEXT_PUBLIC_SUPPORT_EMAIL=

# Stripe: use a dedicated sandbox first. Price must be USD 99.00/month, quantity 1.
# Prefer a restricted rk_test_/rk_live_ server key; never a publishable key.
# Vercel preview/development rejects live keys. Keep sandbox/live databases separate.
# See docs/stripe-setup.md for webhook events, portal settings and purchase tests.
STRIPE_SECRET_KEY=
STRIPE_TEAM_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
STRIPE_AUTOMATIC_TAX=false

# Cloudflare Turnstile for enquiry forms; restrict widget hostnames.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
