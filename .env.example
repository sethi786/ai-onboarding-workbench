# ---------------------------------------------------------------------------
# Clearance AI — environment variables
# Copy to .env.local and fill in with your Supabase project values.
# NEVER commit .env.local. See README "Supabase setup" for the full runbook.
# ---------------------------------------------------------------------------

# Public site URL (used for auth redirect callbacks). No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Service role key — SERVER/SCRIPTS ONLY. Never expose to the browser.
# Used exclusively by scripts/seed-templates.ts (never imported by app code).
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Anthropic API key — SERVER ONLY. Powers the AI assistant: drafting an intake
# from a pasted description, drafting each review team's section, the executive
# summary, and answering reviewer questions from the assessment.
# Leave unset and the product works exactly as before — every AI affordance
# renders an explicit "unavailable" state instead of failing.
ANTHROPIC_API_KEY=
